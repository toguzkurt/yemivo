<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <TextView
        android:id="@+id/tvSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md_lg"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:text="@string/onboarding_skip"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_body_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvIllustration"
        android:layout_width="@dimen/onboarding_illustration_size"
        android:layout_height="@dimen/onboarding_illustration_size"
        android:background="@drawable/bg_circle_accent"
        android:gravity="center"
        android:text="🍲"
        android:textSize="@dimen/text_illustration"
        app:layout_constraintBottom_toTopOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSkip"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="🍲" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xxl"
        android:layout_marginTop="@dimen/spacing_xl"
        android:layout_marginEnd="@dimen/spacing_xxl"
        android:gravity="center"
        android:text="@string/onboarding_page1_title"
        android:textAppearance="@style/TextAppearance.Yemivo.ScreenTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvIllustration" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xxl"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginEnd="@dimen/spacing_xxl"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:text="@string/onboarding_page1_desc"
        android:textAppearance="@style/TextAppearance.Yemivo.BodySecondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <LinearLayout
        android:id="@+id/dotsIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDescription">

        <View
            android:layout_width="@dimen/dot_indicator_active_width"
            android:layout_height="@dimen/dot_indicator_size"
            android:background="@drawable/bg_dot_active" />

        <View
            android:layout_width="@dimen/dot_indicator_size"
            android:layout_height="@dimen/dot_indicator_size"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="@drawable/bg_dot_inactive" />

        <View
            android:layout_width="@dimen/dot_indicator_size"
            android:layout_height="@dimen/dot_indicator_size"
            android:layout_marginStart="@dimen/spacing_xs"
            android:background="@drawable/bg_dot_inactive" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnContinue"
        style="@style/Widget.Yemivo.ButtonDark"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xxl"
        android:layout_marginTop="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/spacing_xxl"
        android:layout_marginBottom="@dimen/spacing_xxl"
        android:text="@string/onboarding_continue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dotsIndicator" />

</androidx.constraintlayout.widget.ConstraintLayout>
