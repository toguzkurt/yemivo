<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <TextView
        android:id="@+id/tvSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md_lg"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:text="@string/onboarding_skip"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_body_sm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Mirrors the mockup's ".illus { flex:1 }": fills the space between Skip and the
         bottom-pinned content block below, with the icon centered inside that space. -->
    <TextView
        android:id="@+id/tvIllustration"
        android:layout_width="@dimen/onboarding_illustration_size"
        android:layout_height="@dimen/onboarding_illustration_size"
        android:background="@drawable/bg_circle_accent"
        android:gravity="center"
        android:textSize="@dimen/text_illustration"
        app:layout_constraintBottom_toTopOf="@id/contentBlock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSkip"
        app:layout_constraintVertical_bias="0.5"
        tools:text="🍲" />

    <!-- Title/description/dots/button stack as one plain block anchored to the bottom, exactly
         like the mockup's ".content" sitting right after the flexible illustration area — a
         LinearLayout avoids the fragile multi-view ConstraintLayout chain the old layout had
         (title/description/dots never linked back up, so the button ended up floating on its
         own bias between the dots and the screen bottom instead of following them). -->
    <LinearLayout
        android:id="@+id/contentBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_xxl"
        android:layout_marginEnd="@dimen/spacing_xxl"
        android:layout_marginBottom="@dimen/spacing_xxl"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/onboarding_page1_title"
            android:textAppearance="@style/TextAppearance.Yemivo.ScreenTitle" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/onboarding_page1_desc"
            android:textAppearance="@style/TextAppearance.Yemivo.BodySecondary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="@dimen/dot_indicator_active_width"
                android:layout_height="@dimen/dot_indicator_size"
                android:background="@drawable/bg_dot_active" />

            <View
                android:id="@+id/dot2"
                android:layout_width="@dimen/dot_indicator_size"
                android:layout_height="@dimen/dot_indicator_size"
                android:layout_marginStart="@dimen/spacing_xs"
                android:background="@drawable/bg_dot_inactive" />

            <View
                android:id="@+id/dot3"
                android:layout_width="@dimen/dot_indicator_size"
                android:layout_height="@dimen/dot_indicator_size"
                android:layout_marginStart="@dimen/spacing_xs"
                android:background="@drawable/bg_dot_inactive" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnContinue"
            style="@style/Widget.Yemivo.ButtonDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:text="@string/onboarding_continue" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
