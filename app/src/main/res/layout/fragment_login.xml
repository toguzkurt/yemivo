<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_huge"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xxl"
            android:paddingEnd="@dimen/spacing_xxl">

            <TextView
                android:layout_width="@dimen/avatar_size_lg"
                android:layout_height="@dimen/avatar_size_lg"
                android:background="@drawable/bg_rounded_square_accent"
                android:gravity="center"
                android:text="🍽"
                android:textSize="@dimen/text_headline_lg" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/login_title"
                android:textAppearance="@style/TextAppearance.Yemivo.HeadlineSm" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxs"
                android:text="@string/login_subtitle"
                android:textAppearance="@style/TextAppearance.Yemivo.BodySecondary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xxl"
            android:paddingEnd="@dimen/spacing_xxl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_label_email"
                android:textAppearance="@style/TextAppearance.Yemivo.Caption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxxs"
                android:background="@drawable/bg_input_field"
                android:minHeight="44dp"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_md_lg"
                android:paddingEnd="@dimen/spacing_md_lg"
                android:text="@string/login_placeholder_email"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/login_label_password"
                android:textAppearance="@style/TextAppearance.Yemivo.Caption" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xxxs"
                android:background="@drawable/bg_input_field"
                android:minHeight="44dp"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/spacing_md_lg"
                android:paddingEnd="@dimen/spacing_md_lg"
                android:text="@string/login_placeholder_password"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/btnLogin"
                style="@style/Widget.Yemivo.ButtonDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md_lg"
                android:text="@string/action_login" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_xxl"
            android:layout_marginTop="@dimen/spacing_xl"
            android:layout_marginEnd="@dimen/spacing_xxl"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm_md"
                android:layout_marginEnd="@dimen/spacing_sm_md"
                android:text="@string/login_or_divider"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_sm" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/border" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xxl"
            android:paddingEnd="@dimen/spacing_xxl">

            <TextView
                style="@style/Widget.Yemivo.ButtonOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_continue_google" />

            <TextView
                style="@style/Widget.Yemivo.ButtonOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm_md"
                android:text="@string/login_continue_apple" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxl"
            android:layout_marginBottom="@dimen/spacing_xl"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_no_account"
                android:textAppearance="@style/TextAppearance.Yemivo.BodySecondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xxs"
                android:text="@string/login_register"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_body_sm"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
