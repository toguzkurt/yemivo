<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_divider_bottom"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_lg"
    android:paddingTop="@dimen/spacing_sm_md"
    android:paddingEnd="@dimen/spacing_lg"
    android:paddingBottom="@dimen/spacing_sm_md">

    <View
        android:id="@+id/ivUnreadDot"
        android:layout_width="@dimen/notif_dot_size"
        android:layout_height="@dimen/notif_dot_size"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_dot_active" />

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/notif_icon_size"
        android:layout_height="@dimen/notif_icon_size"
        android:layout_marginStart="@dimen/spacing_sm_md"
        android:background="@drawable/bg_icon_box_accent"
        android:contentDescription="@null"
        android:padding="@dimen/spacing_sm"
        android:src="@drawable/ic_bell"
        android:scaleType="centerInside"
        app:tint="@color/accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            tools:text="@string/notif_daily_recipe_title" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxxs"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_sm"
            tools:text="@string/notif_daily_recipe_message" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxs"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_xs"
            tools:text="@string/notif_time_2h" />

    </LinearLayout>

</LinearLayout>
