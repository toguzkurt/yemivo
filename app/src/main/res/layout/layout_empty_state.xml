<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="@dimen/spacing_huge"
    android:paddingEnd="@dimen/spacing_huge">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/empty_state_icon_size"
        android:layout_height="@dimen/empty_state_icon_size"
        android:background="@drawable/bg_circle_accent"
        android:contentDescription="@null"
        android:padding="@dimen/spacing_xxl"
        android:src="@drawable/ic_heart_outline"
        app:tint="@color/accent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg_xl"
        android:gravity="center"
        android:text="@string/empty_favorites_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_title_sm"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xs"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:text="@string/empty_favorites_message"
        android:textAppearance="@style/TextAppearance.Yemivo.BodySecondary" />

    <TextView
        android:id="@+id/btnAction"
        style="@style/Widget.Yemivo.ButtonDark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:paddingStart="@dimen/spacing_xl"
        android:paddingEnd="@dimen/spacing_xl"
        android:paddingTop="@dimen/spacing_sm_md"
        android:paddingBottom="@dimen/spacing_sm_md"
        android:text="@string/empty_favorites_cta"
        android:textSize="@dimen/text_body_sm" />

</LinearLayout>
