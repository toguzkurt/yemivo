<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm_md"
    android:background="@drawable/bg_card_outline"
    android:padding="@dimen/spacing_sm">

    <ImageView
        android:id="@+id/ivThumb"
        android:layout_width="@dimen/thumb_size_lg"
        android:layout_height="@dimen/thumb_size_lg"
        android:background="@drawable/bg_thumb_placeholder"
        android:contentDescription="@null"
        android:padding="@dimen/spacing_sm"
        android:scaleType="centerInside"
        tools:src="@drawable/cat_ana_yemek"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/infoColumn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_sm_md"
        android:layout_marginEnd="@dimen/spacing_sm_md"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/ivThumb"
        app:layout_constraintEnd_toStartOf="@id/ivFavorite"
        app:layout_constraintStart_toEndOf="@id/ivThumb"
        app:layout_constraintTop_toTopOf="@id/ivThumb"
        app:layout_constraintVertical_chainStyle="packed">

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Yemivo.CardName"
            tools:text="@string/recipe_name_mantı" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxxs"
            android:textAppearance="@style/TextAppearance.Yemivo.CardMeta"
            tools:text="@string/recipe_meta_mantı" />

    </LinearLayout>

    <ImageView
        android:id="@+id/ivFavorite"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_heart_filled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
