<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================ -->
    <!-- Text appearances                                              -->
    <!-- ============================================================ -->

    <style name="TextAppearance.Yemivo.Greeting" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Yemivo.ScreenTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_title_lg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Yemivo.HeadlineSm" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">@dimen/text_headline_sm</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Yemivo.SectionLabel" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Yemivo.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Yemivo.BodySecondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/text_body_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Yemivo.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.Yemivo.CardName" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Yemivo.CardMeta" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Yemivo.NavLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <style name="TextAppearance.Yemivo.NavLabel.Active">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Yemivo.ChipLabel" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Yemivo.ChipLabel.Active">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ============================================================ -->
    <!-- Component styles                                              -->
    <!-- ============================================================ -->

    <style name="Widget.Yemivo" parent="" />

    <!-- Bottom nav active-item indicator — cornerSize 50% of the shorter side always yields a
         full stadium/pill regardless of the indicator's own width/height. -->
    <style name="ShapeAppearance.Yemivo.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- The app theme is a MaterialComponents (M2) theme, whose default BottomNavigationView
         style sets itemActiveIndicatorStyle to @null — the pill has to be opted back in
         explicitly via this style rather than the individual itemActiveIndicator* attributes,
         which only exist on the indicator style itself, not on the NavigationBarView widget. -->
    <style name="Widget.Yemivo.BottomNavActiveIndicator" parent="">
        <item name="android:width">52dp</item>
        <item name="android:height">36dp</item>
        <item name="marginHorizontal">4dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Yemivo.Pill</item>
        <item name="android:color">@color/accent_bg</item>
    </style>

    <style name="Widget.Yemivo.Chip">
        <item name="android:background">@drawable/bg_chip_outline</item>
        <item name="android:paddingStart">@dimen/spacing_md</item>
        <item name="android:paddingEnd">@dimen/spacing_md</item>
        <item name="android:paddingTop">@dimen/spacing_xs</item>
        <item name="android:paddingBottom">@dimen/spacing_xs</item>
        <item name="android:textAppearance">@style/TextAppearance.Yemivo.ChipLabel</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Widget.Yemivo.Chip.Active">
        <item name="android:background">@drawable/bg_chip_active</item>
        <item name="android:textAppearance">@style/TextAppearance.Yemivo.ChipLabel.Active</item>
    </style>

    <style name="Widget.Yemivo.ButtonDark">
        <item name="android:background">@drawable/bg_button_dark</item>
        <item name="android:textColor">@color/cta_dark_text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">@dimen/spacing_md</item>
        <item name="android:paddingBottom">@dimen/spacing_md</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.Yemivo.ButtonOutline">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">@dimen/spacing_md</item>
        <item name="android:paddingBottom">@dimen/spacing_md</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

</resources>
